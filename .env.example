NODE_ENV=development
OPERATOR_MODE=real
PUBLISH_MODE=real
NEXT_PUBLIC_APP_URL=https://your-owned-domain.example

# Infrastructure
DATABASE_URL=postgresql://openclaw:openclaw@localhost:5432/openclaw?schema=public
REDIS_URL=redis://localhost:6379

# Real product, trend, and analytics inputs. Use owned exports or URLs from official API jobs.
PRODUCT_CATALOG_JSON=storage/imports/products.json
TREND_FEED_JSON=storage/imports/trends.json
ANALYTICS_IMPORT_JSON=storage/imports/metrics.json
DEFAULT_COMMISSION_RATE=0.04

# Real AI providers. Set AI_PROVIDER to openai or anthropic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_PROVIDER=openai
ASSET_PROVIDER=openai

# Pinterest official API mode
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# TikTok Content Posting API mode
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_POST_MODE=MEDIA_UPLOAD
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_PHOTO_URLS=

# Amazon affiliate / catalog adapters. PA-API is legacy/deprecated; prefer owned catalog export or current Amazon Creators API exports.
AMAZON_ASSOCIATE_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TYPE=Associates
AMAZON_PAAPI_ENABLED=false
AMAZON_SEARCH_KEYWORDS=home organization
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1
AMAZON_MARKETPLACE=www.amazon.com
