NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Infrastructure
DATABASE_URL=postgresql://openclaw:openclaw@localhost:5432/openclaw?schema=public
REDIS_URL=redis://localhost:6379

# Demo mode works without AI keys. Set these to enable future real providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=mock

# Pinterest official API mode
PINTEREST_ACCESS_TOKEN=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# TikTok Content Posting API mode
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Amazon affiliate / catalog adapters
AMAZON_ASSOCIATE_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TYPE=Associates
